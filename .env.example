# Database
DATABASE_URL="postgresql://user:password@localhost:5432/digital_store"

# Payment Adapter: "cashapp", "afterpay", or "coinbase"
PAYMENT_ADAPTER="cashapp"

# Cash App Pay
CASHAPP_SANDBOX="true"
CASHAPP_MERCHANT_ID=""
CASHAPP_API_KEY=""
CASHAPP_WEBHOOK_SECRET=""

# Afterpay (alternative adapter)
AFTERPAY_SANDBOX="true"
AFTERPAY_MERCHANT_ID=""
AFTERPAY_SECRET_KEY=""
AFTERPAY_WEBHOOK_SECRET=""

# Coinbase Commerce
COINBASE_SANDBOX="true"
COINBASE_COMMERCE_API_KEY=""
COINBASE_COMMERCE_WEBHOOK_SECRET=""

# S3 / R2 Storage (for digital product delivery)
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET="digital-products"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
